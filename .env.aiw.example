# =============================================================================
# AI Whisperers Code Agent — environment template
# =============================================================================
# Don't fill these in by hand. Run:
#
#     ./scripts/aiw-fetch-secrets.sh > .env
#
# That script pulls live values from Bitwarden (vault.sunstein.cloud) via the
# VPS, and from LiteLLM. The committed file you're reading right now only
# documents what each variable is for.

# -----------------------------------------------------------------------------
# LLM access — via LiteLLM gateway (the ONLY LLM secret the agent needs)
# -----------------------------------------------------------------------------
# LiteLLM holds all the underlying provider keys (Anthropic, OpenRouter, Groq,
# Cerebras, SambaNova, NVIDIA, ZAI, HuggingFace, Ollama). The agent never sees
# them. We point at named model aliases instead of provider strings.
#
# Available aliases (from /v1/models on the live gateway, April 2026):
#   primary                 → smart routing (Sonnet for complex / Groq for short)
#   fast                    → groq llama-3.3-70b
#   reasoning               → claude sonnet 4 thinking mode
#   groq-llama-3.3-70b      → groq direct
#   groq-llama-3.1-8b       → groq tiny
#   groq-qwen-32b           → groq qwen
#   zai-glm-4-flash         → free zhipu
#   openrouter-claude-haiku → cheap claude via openrouter
#   openrouter-gemini-flash → google via openrouter
#   hf-qwen3.5-35b          → huggingface qwen
#   hf-kimi-k2.5            → huggingface kimi
#   hf-glm-5                → huggingface glm
#   cerebras-llama-8b       → cerebras (very fast)
#   sambanova-llama-8b      → sambanova
#   nvidia-llama-8b         → nvidia nim
#   mistral-small           → mistral direct
#   ollama-coder            → pc-ale qwen2.5-coder:7b (free local)

LITELLM_GATEWAY_URL=http://72.61.44.159:4000          # VPS production
# LITELLM_GATEWAY_URL=http://100.110.9.12:4000        # pc-ale via Tailscale
# LITELLM_GATEWAY_URL=http://localhost:4000           # local dev
LITELLM_MASTER_KEY=                                    # bw get item litellm-master-key

# Smart routing tier — what alias each job type uses
LITELLM_ROUTING_PRIMARY=primary                        # complex jobs (fix, review, plan)
LITELLM_ROUTING_FAST=fast                              # short jobs (intent classification, summaries)
LITELLM_ROUTING_PLANNING=fast                          # planner internal calls
LITELLM_ROUTING_REASONING=reasoning                    # extended thinking when needed

# -----------------------------------------------------------------------------
# GitHub (PRIMARY git platform)
# -----------------------------------------------------------------------------
GIT_PLATFORM=github
GITHUB_TOKEN=                                          # bw get item github-aiw-code-agent-pat
GITHUB_AGENT_USER=aiw-code-agent
GIT_AUTHOR_NAME=aiw-code-agent
GIT_AUTHOR_EMAIL=code-agent@aiwhisperers.io
WEBHOOK_SECRET_GITHUB=                                 # bw get item github-webhook-secret

# -----------------------------------------------------------------------------
# Linear (issue tracking — replaces JIRA)
# -----------------------------------------------------------------------------
LINEAR_API_KEY=                                        # bw get item linear-api-key
LINEAR_TEAM_ID=
LINEAR_AGENT_LABEL=aiw-agent

# -----------------------------------------------------------------------------
# Supabase (auth + storage + pgvector — replaces Keycloak / S3 / Bedrock)
# -----------------------------------------------------------------------------
SUPABASE_URL=                                          # bw get item supabase-codeagent-url
SUPABASE_ANON_KEY=                                     # bw get item supabase-codeagent-anon
SUPABASE_SERVICE_KEY=                                  # bw get item supabase-codeagent-service

# Direct Postgres (for pgvector embedding tables)
DATABASE_URL=                                          # bw get item supabase-codeagent-pg-url
DATABASE_USER=postgres
DATABASE_PASSWORD=                                     # bw get item supabase-codeagent-pg-pass

# -----------------------------------------------------------------------------
# Hermes gateway (notifications: Telegram primary, Discord/WhatsApp secondary)
# -----------------------------------------------------------------------------
HERMES_GATEWAY_URL=http://72.61.44.159:8765
HERMES_DEFAULT_TARGET=telegram

# -----------------------------------------------------------------------------
# Embeddings (Voyage primary, OpenAI fallback, Ollama for dev)
# -----------------------------------------------------------------------------
VOYAGE_API_KEY=                                        # bw get item voyage-api-key
OPENAI_API_KEY=                                        # bw get item openai-api-key
OLLAMA_BASE_URL=http://100.110.9.12:11434              # pc-ale via Tailscale

# -----------------------------------------------------------------------------
# Web search (Tavily — kept from upstream)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=                                        # bw get item tavily-api-key

# -----------------------------------------------------------------------------
# API security
# -----------------------------------------------------------------------------
API_KEY=                                               # bw get item code-agent-api-key
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://code-agent.aiwhisperers.io

# -----------------------------------------------------------------------------
# Disabled in AIW build (kept here for documentation only)
# -----------------------------------------------------------------------------
# BITBUCKET_*       — dropped (chore:drop-bitbucket)
# AZUREDEVOPS_*     — dropped
# JIRA_*            — replaced by LINEAR_*
# CONFLUENCE_*      — dropped (docs go to repo as PRs)
# AIKIDO_*          — dropped (replaced by GitHub code scanning)
# TEAMS_WEBHOOK_URL — dropped (replaced by Hermes/Telegram)
# KEYCLOAK_*        — dropped (replaced by Supabase Auth)
# AWS_*             — dropped (replaced by Supabase Storage + Voyage)
# ANTHROPIC_API_KEY — dropped (everything goes through LITELLM_GATEWAY_URL)
